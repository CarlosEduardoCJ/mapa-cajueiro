# Modelo de variáveis de ambiente.
# Copie este arquivo para .env.local e preencha os valores.
# O .env.local NÃO vai para o GitHub.

# Endereço do projeto Supabase (Project Settings → API)
VITE_SUPABASE_URL=

# Chave pública do Supabase (publishable key). Nunca use a chave service_role aqui.
VITE_SUPABASE_PUBLISHABLE_KEY=
